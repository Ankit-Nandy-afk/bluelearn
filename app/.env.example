# Copy to .env for local dev (`pnpm dev` in app/).

# Supabase project URL
VITE_SUPABASE_URL=http://127.0.0.1:54321

# Supabase publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Hono API (Wrangler dev server)
VITE_API_BASE=http://localhost:8787

# ONLY set to true if official Bluelearn deployment otherwise set to false
VITE_BLUELEARN_OFFICIAL=